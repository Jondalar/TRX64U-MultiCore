#!/usr/bin/env bash
# T239.1 D24: the public-tree check before every push. Enable once per clone: git config core.hooksPath .githooks
# Git gives this script "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin. For each pushed ref the tree of the pushed
# commit, every file each new commit adds or changes (so a file removed again by a later commit is still found) and the messages of the
# commits the remote does not have are checked (messages: internal hosts and paths, and the Claude attribution lines the maintainer's
# sessions never write). Seconds, no build, no lint.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
zero=0000000000000000000000000000000000000000
rc=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  echo "pre-push: $lref -> $rref"
  python3 -I tools/check_public_tree.py --rev "$lsha" || rc=1
  if [ "$rsha" = "$zero" ] || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then range="$lsha --not --remotes"; else range="$rsha..$lsha"; fi
  python3 -I tools/check_public_tree.py --commits "$range" || rc=1
  python3 -I tools/check_public_tree.py --messages "$range" --trailers || rc=1
done
[ "$rc" = 0 ] || echo "pre-push: refused, nothing was pushed (T239.1 D24)" >&2
exit "$rc"
