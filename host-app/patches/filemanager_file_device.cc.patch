+FileDevice *FileDevice :: find(const char *name)
+{
+    for(FileDevice *d = device_list; d; d = d->next_device) {
+        if(!strcasecmp(d->get_name(), name)) {
+            return d;
+        }
+    }
+    return NULL;
+}
+
+// T111: unmount the volume probe() mounted (the FileSystemFAT's destructor does f_unmount and frees the drive slot) and forget it.
+// Call it before detach_disk(): the volume reads through the Partition that the disk owns.
+void FileDevice :: release_volume(void)
+{
+    if(info.fs) {
+        delete info.fs;
+        info.fs = NULL;
+    }
+    info.cluster = 0;
+    initialized = false;
+}
