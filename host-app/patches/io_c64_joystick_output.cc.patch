+void JoystickOutput :: setPadPort(int port, uint8_t active_low_mask)
+{
+#if U64
+    portENTER_CRITICAL();
+#endif
+    uint8_t v = (active_low_mask & JOYSTICK_DIGITAL_MASK) | (JOYSTICK_INPUT_MASK & ~JOYSTICK_DIGITAL_MASK);
+    if (port) {
+        pad_p2 = v;
+    } else {
+        pad_p1 = v;
+    }
+    apply();
+#if U64
+    portEXIT_CRITICAL();
+#endif
+}
