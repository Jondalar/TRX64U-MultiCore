<screen>
    <view>
        <style name="style_screen" />
        <app_shell active_library="true">
            <app_shell-content>
                <column width="100%" height="100%" pad="#space_lg" gap="#space_md">
                    <row width="100%">
                        <lv_label text="Library" style_text_font="font_title"
                                  style_text_color="#color_ink" />
                        <box grow="1" />
                        <ui_button label="SEARCH">
                            <screen_create_event screen="library_search" anim_type="fade_in" duration="120" />
                        </ui_button>
                    </row>

                    <row width="100%" gap="#space_sm">
                        <ui_button label="RECENT" border_color="#color_violet" />
                        <ui_button label="SD" />
                        <ui_button label="USB" />
                        <ui_button label="NETWORK" />
                        <ui_button label="FAVORITES" />
                    </row>

                    <row width="100%" grow="1" gap="#space_lg" vertical_align="start">
                        <panel grow="1" height="100%" gap="0">
                            <row width="100%" pad="#space_sm">
                                <lv_label text="RECENT" style_text_font="font_caption"
                                          style_text_color="#color_muted" />
                                <box grow="1" />
                                <lv_label text="12 ITEMS" style_text_font="font_caption"
                                          style_text_color="#color_muted" />
                            </row>
                            <action_row title="Last Ninja 2.d64" subtitle="SD:/Games/N" meta="D64"
                                        tone="#color_violet">
                                <screen_create_event screen="library_actions" anim_type="fade_in" duration="120" />
                            </action_row>
                            <action_row title="Sam's Journey.crt" subtitle="USB:/Favorites" meta="CRT"
                                        tone="#color_cyan" />
                            <action_row title="Edge of Disgrace.prg" subtitle="SD:/Demos" meta="PRG"
                                        tone="#color_muted" />
                            <action_row title="Development" subtitle="SD:/Projects" meta="DIR"
                                        tone="#color_muted" />
                            <box grow="1" />
                        </panel>

                        <panel width="230" height="100%" gap="#space_sm" raised="true">
                            <lv_label text="SELECTED" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <lv_label text="Last Ninja 2" width="100%" long_mode="wrap"
                                      style_text_font="font_display" style_text_color="#color_ink" />
                            <lv_label text="D64  /  SD:/Games/N"
                                      style_text_font="font_caption" style_text_color="#color_muted" />
                            <box grow="1" />
                            <ui_button label="MOUNT &amp; RUN" width="100%" bg_color="#color_violet"
                                       border_color="#color_violet" text_color="#color_bg" />
                            <ui_button label="F7  MORE ACTIONS" width="100%">
                                <screen_create_event screen="library_actions" anim_type="fade_in" duration="120" />
                            </ui_button>
                        </panel>
                    </row>
                </column>
            </app_shell-content>
        </app_shell>
    </view>
</screen>
