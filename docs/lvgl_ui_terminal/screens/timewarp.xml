<screen>
    <view>
        <style name="style_screen" />
        <app_shell active_timewarp="true">
            <app_shell-content>
                <column width="100%" height="100%" pad="#space_lg" gap="#space_lg">
                    <row width="100%">
                        <lv_label text="Timewarp" style_text_font="font_title"
                                  style_text_color="#color_ink" />
                        <box grow="1" />
                        <status_chip label="CAPTURING" tone="#color_violet" />
                    </row>

                    <column width="100%" gap="#space_sm">
                        <row width="100%">
                            <lv_label text="-8.4 s" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <box grow="1" />
                            <lv_label bind_text="subject_timewarp_position" bind_text-fmt="%d%%"
                                      style_text_font="font_caption" style_text_color="#color_violet" />
                            <box grow="1" />
                            <lv_label text="LIVE" style_text_font="font_caption"
                                      style_text_color="#color_cyan" />
                        </row>
                        <ui_slider subject="subject_timewarp_position" width="100%" />
                    </column>

                    <box width="100%" grow="1" pad="#space_lg" gap="#space_sm"
                         style_bg_color="#color_surface" style_bg_opa="100%"
                         style_border_width="0" style_radius="#radius_md">
                        <row width="100%">
                            <status_chip label="PREVIEW / -2.7 s" tone="#color_violet" />
                            <box grow="1" />
                            <lv_label text="FRAME 108432" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                        </row>
                        <box grow="1" />
                        <lv_label text="C64 FRAME PREVIEW" style_text_font="font_display"
                                  style_text_color="#color_ink" />
                        <lv_label text="The running session stays unchanged until Resume here."
                                  style_text_font="font_caption" style_text_color="#color_muted" />
                        <box grow="1" />
                    </box>

                    <row width="100%" gap="#space_sm">
                        <ui_button label="-1 FRAME" />
                        <ui_button label="+1 FRAME" />
                        <ui_button label="PLAY PREVIEW" />
                        <box grow="1" />
                        <ui_button label="F7  MARKERS &amp; FILES">
                            <screen_create_event screen="timewarp_actions" anim_type="fade_in" duration="120" />
                        </ui_button>
                        <ui_button label="RESUME HERE" bg_color="#color_violet"
                                   border_color="#color_violet" text_color="#color_bg" />
                    </row>
                </column>
            </app_shell-content>
        </app_shell>
    </view>
</screen>
