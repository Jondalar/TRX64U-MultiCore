<screen>
    <view>
        <style name="style_screen" />
        <app_shell active_home="true">
            <app_shell-content>
                <column width="100%" height="100%" pad="#space_lg" gap="#space_sm">
                    <row width="100%">
                        <lv_label text="HOME" style_text_font="font_title"
                                  style_text_color="#color_ink" />
                        <box grow="1" />
                        <ui_button label="OPEN LIBRARY" text_color="#color_ink">
                            <screen_create_event screen="library" anim_type="fade_in" duration="80" />
                        </ui_button>
                    </row>

                    <lv_label text="SESSION ----------------------------------------------------------------"
                              style_text_font="font_caption" style_text_color="#color_muted" />
                    <row width="100%" gap="#space_sm">
                        <lv_label text="LAST NINJA 2" style_text_font="font_display"
                                  style_text_color="#color_ink" />
                        <status_chip label="RUNNING" tone="#color_cyan" />
                    </row>
                    <lv_label text="PAL / 1.00 MHz / 50.12 Hz"
                              style_text_font="font_caption" style_text_color="#color_muted" />
                    <row width="100%" gap="#space_sm">
                        <ui_button label="PAUSE" />
                        <ui_button label="MACHINE + MEDIA">
                            <screen_create_event screen="c64" anim_type="fade_in" duration="80" />
                        </ui_button>
                    </row>

                    <lv_label text="STATUS -----------------------------------------------------------------"
                              style_text_font="font_caption" style_text_color="#color_muted" />
                    <action_row title="Drive 8" subtitle="LN2.d64" meta="CLEAN" tone="#color_cyan">
                        <screen_create_event screen="library_actions" anim_type="fade_in" duration="80" />
                    </action_row>
                    <action_row title="Timewarp" subtitle="8.4 seconds" meta="REC" tone="#color_violet">
                        <screen_create_event screen="timewarp" anim_type="fade_in" duration="80" />
                    </action_row>
                    <action_row title="Network" subtitle="StudioNet" meta="ONLINE" tone="#color_cyan">
                        <screen_create_event screen="settings_network" anim_type="fade_in" duration="80" />
                    </action_row>

                    <box grow="1" />
                    <ui_button label="F7 QUICK ACTIONS">
                        <screen_create_event screen="quick_actions" anim_type="fade_in" duration="80" />
                    </ui_button>
                </column>
            </app_shell-content>
        </app_shell>
    </view>
</screen>
