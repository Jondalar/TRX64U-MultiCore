<screen>
    <view>
        <style name="style_screen" />
        <app_shell active_settings="true" active_tab="0">
            <app_shell-content>
                <column width="100%" height="100%" pad="#space_lg" gap="#space_lg">
                    <row width="100%">
                        <lv_label text="Settings" style_text_font="font_title"
                                  style_text_color="#color_ink" />
                        <box grow="1" />
                        <status_chip label="DEFAULT / SAVED" tone="#color_cyan" />
                    </row>

                    <panel width="100%" grow="1" gap="0">
                        <action_row title="TRX64" subtitle="Session, persistence, and M2 behavior"
                                    meta="M2" tone="#color_violet">
                            <screen_create_event screen="settings_trx64" anim_type="fade_in" duration="120" />
                        </action_row>
                        <action_row title="Video &amp; overlay" subtitle="Output and overlay appearance"
                                    meta="VIDEO" tone="#color_cyan">
                            <screen_create_event screen="settings_video" anim_type="fade_in" duration="120" />
                        </action_row>
                        <action_row title="Audio &amp; SID" subtitle="Mixer and emulation"
                                    meta="AUDIO" tone="#color_amber">
                            <screen_create_event screen="settings_audio" anim_type="fade_in" duration="120" />
                        </action_row>
                        <action_row title="Controllers" subtitle="Ports and mappings"
                                    meta="INPUT" tone="#color_muted">
                            <screen_create_event screen="settings_controllers" anim_type="fade_in" duration="120" />
                        </action_row>
                        <action_row title="Network" subtitle="Wi-Fi and services"
                                    meta="ONLINE" tone="#color_cyan">
                            <screen_create_event screen="settings_network" anim_type="fade_in" duration="120" />
                        </action_row>
                        <action_row title="Drives &amp; peripherals" subtitle="IEC, drives, and printer"
                                    meta="I/O" tone="#color_muted">
                            <screen_create_event screen="settings_peripherals" anim_type="fade_in" duration="120" />
                        </action_row>
                        <action_row title="System &amp; expert" subtitle="Memory, cartridge, power, UI, and maintenance"
                                    meta="ADVANCED" tone="#color_muted">
                            <screen_create_event screen="settings_advanced" anim_type="fade_in" duration="120" />
                        </action_row>
                    </panel>
                </column>
            </app_shell-content>
        </app_shell>
    </view>
</screen>
