<screen>
    <view>
        <style name="style_screen" />
        <app_shell active_actions="true" active_tab="2">
            <app_shell-content>
                <column width="100%" height="100%" pad="#space_xl"
                        horizontal_align="center" vertical_align="center">
                    <panel width="600" gap="#space_lg" raised="true">
                        <status_chip label="PERSISTENT DATA" tone="#color_amber" />
                        <lv_label text="Save cartridge changes?" style_text_font="font_title"
                                  style_text_color="#color_ink" />
                        <lv_label text="Sam's Journey.crt changed since the last writeback at 14:32."
                                  width="100%" long_mode="wrap" style_text_font="font_body"
                                  style_text_color="#color_muted" />
                        <lv_label text="USB:/Favorites/Sam's Journey.crt"
                                  style_text_font="font_caption" style_text_color="#color_muted" />
                        <row width="100%" gap="#space_sm" horizontal_align="end">
                            <lv_label text="&lt;-  CANCEL" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <ui_button label="EJECT WITHOUT SAVING" border_color="#color_coral"
                                       text_color="#color_coral">
                                <screen_create_event screen="c64" anim_type="fade_in" duration="120" />
                            </ui_button>
                            <ui_button label="SAVE &amp; EJECT" bg_color="#color_amber"
                                       border_color="#color_amber" text_color="#color_bg">
                                <screen_create_event screen="c64" anim_type="fade_in" duration="120" />
                            </ui_button>
                        </row>
                    </panel>
                </column>
            </app_shell-content>
        </app_shell>
    </view>
</screen>
