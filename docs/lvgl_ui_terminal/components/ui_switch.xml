<component>
    <api>
        <prop name="subject" type="subject" />
        <prop name="tone" type="color" default="#color_violet" />
        <prop name="state" type="string" default="ON" />
    </api>

    <view extends="lv_switch" width="42" height="16" bind_checked="$subject"
          style_bg_opa="0%" style_bg_opa-indicator-checked="0%"
          style_bg_opa-knob="0%" style_pad_all-knob="0">
        <style name="style_focus" selector="focused" />
        <style name="style_focus" selector="focus_key" />
        <row gap="0">
            <lv_label text="[" style_text_font="font_caption" style_text_color="$tone" />
            <lv_label text="$state" style_text_font="font_caption" style_text_color="$tone" />
            <lv_label text="]" style_text_font="font_caption" style_text_color="$tone" />
        </row>
    </view>
</component>
