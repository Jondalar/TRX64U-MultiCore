<component>
    <api>
        <prop name="title" type="string" default="Setting" />
        <prop name="description" type="string" default="" />
        <slot name="control" />
    </api>

    <view extends="box" flow="row" width="100%" height="38" gap="#space_sm"
          style_flex_cross_place="center" style_pad_hor="#space_xs"
          style_border_width="0">
        <lv_label text="$title" style_text_font="font_body" style_text_color="#color_ink" />
        <lv_label text="$description" hidden="{!description}" long_mode="wrap"
                  style_flex_grow="1" style_text_font="font_caption" style_text_color="#color_muted" />
        <box name="control" flow="row" gap="#space_xs" />
    </view>
</component>
