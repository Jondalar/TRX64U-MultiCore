<component>
    <api>
        <prop name="title" type="string" default="Action" />
        <prop name="subtitle" type="string" default="" />
        <prop name="meta" type="string" default="" />
        <prop name="tone" type="color" default="#color_muted" />
    </api>

    <view extends="lv_button" width="100%" height="32" flex_flow="row"
          style_flex_cross_place="center" style_pad_hor="#space_xs"
          style_pad_ver="0" style_pad_column="#space_sm"
          style_bg_color="#color_bg" style_bg_opa="100%"
          style_border_width="0" style_radius="0" style_shadow_width="0">
        <style name="style_focus" selector="focused" />
        <style name="style_focus" selector="focus_key" />
        <style name="style_pressed" selector="pressed" />
        <lv_label text=">" style_text_font="font_body" style_text_color="$tone" />
        <lv_label text="$title" style_text_font="font_body" style_text_color="#color_ink" />
        <lv_label text="$subtitle" hidden="{!subtitle}"
                  style_text_font="font_caption" style_text_color="#color_muted" />
        <box grow="1" />
        <row hidden="{!meta}" gap="0">
            <lv_label text="[" style_text_font="font_caption" style_text_color="$tone" />
            <lv_label text="$meta" style_text_font="font_caption" style_text_color="$tone" />
            <lv_label text="]" style_text_font="font_caption" style_text_color="$tone" />
        </row>
    </view>
</component>
