<component>
    <api>
        <prop name="number" type="string" default="1" />
        <prop name="label" type="string" default="TAB" />
        <prop name="active" type="bool" default="false" />
    </api>

    <view extends="lv_button" width="content" height="20" flex_flow="row"
          style_flex_cross_place="center" style_pad_hor="#space_xs"
          style_pad_column="0" style_radius="0" style_border_width="0"
          style_shadow_width="0" style_bg_color="#color_line"
          style_bg_opa="{active ? 255 : 0}">
        <style name="style_focus" selector="focused" />
        <style name="style_focus" selector="focus_key" />
        <style name="style_pressed" selector="pressed" />
        <lv_label text="[" style_text_font="font_caption"
                  style_text_color="{active ? color_ink : color_muted}" />
        <lv_label text="$number" style_text_font="font_caption"
                  style_text_color="{active ? color_ink : color_muted}" />
        <lv_label text="]" style_text_font="font_caption"
                  style_text_color="{active ? color_ink : color_muted}" />
        <lv_label text="$label" style_text_font="font_caption"
                  style_text_color="{active ? color_ink : color_muted}" />
    </view>
</component>
