<component>
    <api>
        <prop name="glyph" type="string" default="?" />
        <prop name="width" type="int" default="24" />
        <prop name="tone" type="color" default="#color_muted" />
        <prop name="text_color" type="color" default="#color_ink" />
    </api>

    <view extends="base_box" width="$width" height="16" flex_flow="row"
          style_flex_main_place="center" style_flex_cross_place="center">
        <lv_label text="[" style_text_font="font_caption" style_text_color="$text_color" />
        <lv_label text="$glyph" style_text_font="font_caption" style_text_color="$text_color" />
        <lv_label text="]" style_text_font="font_caption" style_text_color="$text_color" />
    </view>
</component>
