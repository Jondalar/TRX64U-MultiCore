<screen>
    <view>
        <style name="style_screen" />
        <crt_shell active_tab="3" state="CONFIRM" tone="#color_amber"
                   close_label="CANCEL">
            <crt_shell-content>
                <column width="100%" height="100%" style_flex_main_place="center"
                        style_flex_cross_place="center">
                    <panel width="640" gap="#space_lg" raised="true">
                        <row width="100%">
                            <column grow="1" gap="#space_xs">
                                <lv_label text="FLASH CARTRIDGE" style_text_font="font_caption"
                                          style_text_color="#color_amber" />
                                <lv_label text="Write this image?" style_text_font="font_title"
                                          style_text_color="#color_ink" />
                            </column>
                            <status_chip label="DESTRUCTIVE" tone="#color_amber" />
                        </row>

                        <lv_label text="The selected EasyFlash 3 slot is erased before programming. Other slots and the system area remain unchanged."
                                  width="100%" long_mode="wrap" style_text_font="font_body"
                                  style_text_color="#color_ink" />

                        <panel width="100%" gap="#space_sm">
                            <row width="100%"><lv_label text="SOURCE" width="82" style_text_font="font_caption" style_text_color="#color_muted" /><lv_label text="sams_journey.crt" style_text_font="font_body" style_text_color="#color_ink" /></row>
                            <row width="100%"><lv_label text="TARGET" width="82" style_text_font="font_caption" style_text_color="#color_muted" /><lv_label text="EasyFlash 3 / Slot 2 / Sam's Journey" style_text_font="font_body" style_text_color="#color_ink" /></row>
                            <row width="100%"><lv_label text="IMPACT" width="82" style_text_font="font_caption" style_text_color="#color_muted" /><lv_label text="16 sectors erased, 64 banks written" style_text_font="font_body" style_text_color="#color_amber" /></row>
                        </panel>

                        <row width="100%" gap="#space_md" style_flex_main_place="end">
                            <ui_button label="CANCEL">
                                <screen_create_event screen="crt_flash" anim_type="fade_in" duration="100" />
                            </ui_button>
                            <ui_button label="WRITE SLOT 2" bg_color="#color_amber"
                                       border_color="#color_amber" text_color="#color_bg">
                                <screen_create_event screen="crt_progress" anim_type="fade_in" duration="100" />
                            </ui_button>
                        </row>
                    </panel>
                </column>
            </crt_shell-content>
        </crt_shell>
    </view>
</screen>
