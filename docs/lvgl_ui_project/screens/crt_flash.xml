<screen>
    <view>
        <style name="style_screen" />
        <crt_shell active_tab="3" state="READY" tone="#color_amber"
                   f1="SCAN" f3="WRITE" f5="VERIFY" f7="SLOT / ERASE">
            <crt_shell-content>
                <column width="100%" height="100%" pad="#space_lg" gap="#space_md">
                    <row width="100%">
                        <column grow="1" gap="#space_xs">
                            <lv_label text="TREX CRT / FLASH" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <lv_label text="Flash cartridge" style_text_font="font_title"
                                      style_text_color="#color_ink" />
                        </column>
                        <status_chip label="WRITES CARTRIDGE" tone="#color_amber" />
                    </row>

                    <panel width="100%" gap="#space_sm">
                        <row width="100%">
                            <lv_label text="SOURCE" width="74" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <lv_label text="/Usb0/Images/sams_journey.crt" style_text_font="font_body"
                                      style_text_color="#color_ink" />
                            <box grow="1" />
                            <status_chip label="EASYFLASH CRT" tone="#color_cyan" />
                        </row>
                        <row width="100%">
                            <lv_label text="TARGET" width="74" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <lv_label text="EasyFlash 3 / Slot 2 / Sam's Journey"
                                      style_text_font="font_body" style_text_color="#color_ink" />
                            <box grow="1" />
                            <ui_button label="CHANGE SLOT" />
                        </row>
                        <row width="100%">
                            <lv_label text="MAINT." width="74" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <lv_label text="EasyFlash 3 whole-cartridge operations"
                                      style_text_font="font_body" style_text_color="#color_ink" />
                            <box grow="1" />
                            <ui_button label="ERASE WHOLE EF3..." bg_color="#color_coral"
                                       border_color="#color_coral" text_color="#color_bg">
                                <screen_create_event screen="crt_erase_confirm" anim_type="fade_in" duration="120" />
                            </ui_button>
                        </row>
                    </panel>

                    <row width="100%" grow="1" gap="#space_lg" vertical_align="start">
                        <panel grow="1" height="100%" gap="0">
                            <crt_bank_map title="ROML" detail="64 BANKS" tone="#color_amber" />
                        </panel>
                        <panel grow="1" height="100%" gap="0">
                            <crt_bank_map title="ROMH" detail="64 BANKS" tone="#color_amber" />
                        </panel>
                    </row>

                    <row width="100%" gap="#space_md">
                        <lv_label text="STATUS" style_text_font="font_caption" style_text_color="#color_muted" />
                        <lv_label text="Source and target are compatible. Writing erases slot 2 first."
                                  style_text_font="font_body" style_text_color="#color_ink" />
                        <box grow="1" />
                        <ui_button label="WRITE CARTRIDGE" bg_color="#color_amber"
                                   border_color="#color_amber" text_color="#color_bg">
                            <screen_create_event screen="crt_confirm" anim_type="fade_in" duration="120" />
                        </ui_button>
                    </row>
                </column>
            </crt_shell-content>
        </crt_shell>
    </view>
</screen>
