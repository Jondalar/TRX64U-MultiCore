<screen>
    <view>
        <style name="style_screen" />
        <crt_shell active_tab="3" state="WRITING 43%" tone="#color_amber"
                   close_label="LOCKED">
            <crt_shell-content>
                <column width="100%" height="100%" pad="#space_lg" gap="#space_md">
                    <row width="100%">
                        <column grow="1" gap="#space_xs">
                            <lv_label text="TREX CRT / FLASH" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <lv_label text="Writing slot 2" style_text_font="font_title"
                                      style_text_color="#color_ink" />
                        </column>
                        <status_chip label="DO NOT REMOVE" tone="#color_coral" />
                    </row>

                    <panel width="100%" gap="#space_md" raised="true">
                        <row width="100%">
                            <lv_label text="PROGRAMMING ROML BANK $1B" style_text_font="font_body"
                                      style_text_color="#color_ink" />
                            <box grow="1" />
                            <lv_label text="27 / 64" style_text_font="font_caption"
                                      style_text_color="#color_amber" />
                        </row>
                        <ui_bar subject="subject_crt_progress" tone="#color_amber" />
                        <lv_label text="The current sector must finish before the operation can stop. R/S is temporarily locked."
                                  style_text_font="font_caption" style_text_color="#color_muted" />
                    </panel>

                    <row width="100%" grow="1" gap="#space_lg" vertical_align="start">
                        <panel grow="1" height="100%" gap="0">
                            <crt_bank_map title="ROML" detail="BANK $1B" tone="#color_amber" />
                        </panel>
                        <panel grow="1" height="100%" gap="0">
                            <crt_bank_map title="ROMH" detail="WAITING" tone="#color_muted" />
                        </panel>
                    </row>

                    <row width="100%" gap="#space_md">
                        <lv_label text="STATUS" style_text_font="font_caption" style_text_color="#color_muted" />
                        <lv_label text="Programming and checking each byte..."
                                  style_text_font="font_body" style_text_color="#color_ink" />
                        <box grow="1" />
                        <ui_button label="SHOW COMPLETED STATE">
                            <screen_create_event screen="crt_result" anim_type="fade_in" duration="100" />
                        </ui_button>
                    </row>
                </column>
            </crt_shell-content>
        </crt_shell>
    </view>
</screen>
