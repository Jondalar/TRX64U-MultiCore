<screen>
    <view>
        <style name="style_screen" />
        <app_shell active_settings="true" active_tab="3">
            <app_shell-content>
                <column width="100%" height="100%" pad="#space_lg" gap="#space_md">
                    <row width="100%">
                        <column grow="1" gap="#space_xs">
                            <lv_label text="SETTINGS / AUDIO &amp; SID" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <lv_label text="Sound" style_text_font="font_title"
                                      style_text_color="#color_ink" />
                        </column>
                        <status_chip label="RUNTIME CATALOG" tone="#color_amber" />
                    </row>

                    <panel width="100%" grow="1" gap="0">
                        <action_row title="Audio mixer" subtitle="21 registered parameters"
                                    meta="21" tone="#color_amber">
                            <screen_create_event screen="settings_page" anim_type="fade_in" duration="120" />
                        </action_row>
                        <action_row title="Speaker mixer" subtitle="11 registered parameters"
                                    meta="11" tone="#color_muted">
                            <screen_create_event screen="settings_page" anim_type="fade_in" duration="120" />
                        </action_row>
                        <action_row title="SID sockets" subtitle="Socket type, enable, and routing"
                                    meta="8" tone="#color_cyan">
                            <screen_create_event screen="settings_page" anim_type="fade_in" duration="120" />
                        </action_row>
                        <action_row title="SID addressing" subtitle="Address map and visual editor"
                                    meta="9" tone="#color_violet">
                            <screen_create_event screen="settings_page" anim_type="fade_in" duration="120" />
                        </action_row>
                        <action_row title="UltiSID" subtitle="Internal SID configuration"
                                    meta="8" tone="#color_muted">
                            <screen_create_event screen="settings_page" anim_type="fade_in" duration="120" />
                        </action_row>
                        <action_row title="SID player behavior" subtitle="Playback policy"
                                    meta="2" tone="#color_muted">
                            <screen_create_event screen="settings_page" anim_type="fade_in" duration="120" />
                        </action_row>
                        <action_row title="Detected SID devices" subtitle="ARMSID, FPGASID, SIDKick, SwinSID, or PD-SID"
                                    meta="DYNAMIC" tone="#color_cyan">
                            <screen_create_event screen="settings_page" anim_type="fade_in" duration="120" />
                        </action_row>
                    </panel>
                </column>
            </app_shell-content>
        </app_shell>
    </view>
</screen>
