<screen>
    <view>
        <style name="style_screen" />
        <app_shell active_actions="true" active_tab="4">
            <app_shell-content>
                <column width="100%" height="100%" pad="#space_lg" gap="#space_lg">
                    <column width="100%" gap="#space_xs">
                        <lv_label text="LIBRARY / D64" style_text_font="font_caption"
                                  style_text_color="#color_muted" />
                        <lv_label text="Last Ninja 2.d64" style_text_font="font_title"
                                  style_text_color="#color_ink" />
                    </column>

                    <row width="100%" grow="1" gap="#space_lg" vertical_align="start">
                        <panel grow="1" height="100%" gap="0">
                            <action_row title="Mount and run" subtitle="Drive 8 / first runnable entry"
                                        meta="DEFAULT" tone="#color_violet" />
                            <action_row title="Mount in Drive 8" subtitle="Keep the current C64 session"
                                        meta="D8" tone="#color_cyan" />
                            <action_row title="Mount in Drive 9" subtitle="Use the secondary drive"
                                        meta="D9" tone="#color_cyan" />
                            <action_row title="Browse contents" subtitle="Choose a PRG inside the image"
                                        meta="OPEN" tone="#color_muted" />
                            <action_row title="Manage file" subtitle="Copy, move, rename, delete, and selection"
                                        meta="FILE" tone="#color_muted">
                                <screen_create_event screen="library_manage" anim_type="fade_in" duration="120" />
                            </action_row>
                            <box grow="1" />
                        </panel>

                        <panel width="250" height="100%" gap="#space_md" raised="true">
                            <row width="100%">
                                <lv_label text="FORMAT" style_text_font="font_caption"
                                          style_text_color="#color_muted" />
                                <box grow="1" />
                                <lv_label text="D64" style_text_font="font_body"
                                          style_text_color="#color_ink" />
                            </row>
                            <row width="100%">
                                <lv_label text="DRIVE 8" style_text_font="font_caption"
                                          style_text_color="#color_muted" />
                                <box grow="1" />
                                <status_chip label="CLEAN" tone="#color_cyan" />
                            </row>
                            <box grow="1" />
                            <ui_button label="SAFE EJECT" width="100%"
                                       border_color="#color_amber" text_color="#color_amber">
                                <screen_create_event screen="media_eject" anim_type="fade_in" duration="120" />
                            </ui_button>
                            <lv_label text="Actions are supplied by file type + app catalog"
                                      width="100%" long_mode="wrap"
                                      style_text_font="font_caption" style_text_color="#color_muted" />
                            <lv_label text="←  BACK TO LIBRARY" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                        </panel>
                    </row>
                </column>
            </app_shell-content>
        </app_shell>
    </view>
</screen>
