<screen>
    <view>
        <style name="style_screen" />
        <app_shell active_tools="true" active_tab="5">
            <app_shell-content>
                <column width="100%" height="100%" pad="#space_lg" gap="#space_md">
                    <row width="100%">
                        <column grow="1" gap="#space_xs">
                            <lv_label text="TOOLS / STREAMS" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <lv_label text="Video and audio" style_text_font="font_title"
                                      style_text_color="#color_ink" />
                        </column>
                        <status_chip label="ALL OFF" tone="#color_muted" />
                    </row>

                    <panel width="100%" grow="1" gap="0">
                        <action_row title="VIC video stream" subtitle="Start or stop the active endpoint"
                                    meta="OFF" tone="#color_muted" />
                        <action_row title="Audio stream" subtitle="Start or stop the active endpoint"
                                    meta="OFF" tone="#color_muted" />
                        <action_row title="Debug stream" subtitle="Build-dependent diagnostic output"
                                    meta="OFF" tone="#color_muted" />
                        <action_row title="Data stream settings" subtitle="Four registered parameters"
                                    meta="4" tone="#color_violet">
                            <screen_create_event screen="settings_page" anim_type="fade_in" duration="120" />
                        </action_row>
                        <box grow="1" />
                    </panel>

                    <lv_label text="State markers replace the control-code prefixes used by legacy labels"
                              style_text_font="font_caption" style_text_color="#color_muted" />
                </column>
            </app_shell-content>
        </app_shell>
    </view>
</screen>
