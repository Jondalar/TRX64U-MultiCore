<screen>
    <view>
        <style name="style_screen" />
        <crt_shell active_tab="3" state="ERASE" tone="#color_coral"
                   close_label="CANCEL">
            <crt_shell-content>
                <column width="100%" height="100%" style_flex_main_place="center"
                        style_flex_cross_place="center">
                    <panel width="700" gap="#space_lg" raised="true">
                        <row width="100%">
                            <column grow="1" gap="#space_xs">
                                <lv_label text="EASYFLASH 3 MAINTENANCE" style_text_font="font_caption"
                                          style_text_color="#color_coral" />
                                <lv_label text="Erase the whole cartridge?" style_text_font="font_title"
                                          style_text_color="#color_ink" />
                            </column>
                            <status_chip label="IRREVERSIBLE" tone="#color_coral" />
                        </row>

                        <lv_label text="This erases all 8 MB: the system area, menu, KERNALs, directory and every slot. The cartridge will not start until a system image is written back."
                                  width="100%" long_mode="wrap" style_text_font="font_body"
                                  style_text_color="#color_ink" />

                        <panel width="100%" gap="#space_sm">
                            <row width="100%"><lv_label text="TARGET" width="104" style_text_font="font_caption" style_text_color="#color_muted" /><lv_label text="EasyFlash 3 / complete physical cartridge" style_text_font="font_body" style_text_color="#color_ink" /></row>
                            <row width="100%"><lv_label text="ERASES" width="104" style_text_font="font_caption" style_text_color="#color_muted" /><lv_label text="System area + directory + slots 1-7" style_text_font="font_body" style_text_color="#color_coral" /></row>
                            <row width="100%"><lv_label text="RECOVERY" width="104" style_text_font="font_caption" style_text_color="#color_muted" /><lv_label text="Write a complete type 90 system image" style_text_font="font_body" style_text_color="#color_ink" /></row>
                        </panel>

                        <row width="100%" gap="#space_md" vertical_align="center">
                            <lv_label text="FINAL CONFIRMATION" style_text_font="font_caption"
                                      style_text_color="#color_coral" />
                            <lv_label text="The preceding menu choice is confirmation 1 of 2."
                                      style_text_font="font_caption" style_text_color="#color_muted" />
                            <box grow="1" />
                            <ui_button label="CANCEL">
                                <screen_create_event screen="crt_flash" anim_type="fade_in" duration="100" />
                            </ui_button>
                            <ui_button label="ERASE ALL 8 MB" bg_color="#color_coral"
                                       border_color="#color_coral" text_color="#color_bg">
                                <screen_create_event screen="crt_progress" anim_type="fade_in" duration="100" />
                            </ui_button>
                        </row>
                    </panel>
                </column>
            </crt_shell-content>
        </crt_shell>
    </view>
</screen>
