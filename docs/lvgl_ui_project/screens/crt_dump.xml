<screen>
    <view>
        <style name="style_screen" />
        <crt_shell active_tab="2" state="READY" tone="#color_cyan"
                   f1="SCAN" f3="DUMP" f5="INSPECT" f7="SLOT">
            <crt_shell-content>
                <column width="100%" height="100%" pad="#space_lg" gap="#space_md">
                    <row width="100%">
                        <column grow="1" gap="#space_xs">
                            <lv_label text="TREX CRT / DUMP" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <lv_label text="Dump cartridge" style_text_font="font_title"
                                      style_text_color="#color_ink" />
                        </column>
                        <status_chip label="EASYFLASH 3" tone="#color_violet" />
                    </row>

                    <panel width="100%" gap="#space_sm">
                        <row width="100%">
                            <lv_label text="TARGET" width="74" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <lv_label text="Slot 2 / Sam's Journey" style_text_font="font_body"
                                      style_text_color="#color_ink" />
                            <box grow="1" />
                            <status_chip label="64 BANKS" tone="#color_cyan" />
                        </row>
                        <row width="100%">
                            <lv_label text="SAVE AS" width="74" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <lv_label text="/Usb0/Backups/sams_journey.crt" style_text_font="font_body"
                                      style_text_color="#color_ink" />
                            <box grow="1" />
                            <ui_button label="CHANGE" />
                        </row>
                    </panel>

                    <row width="100%" grow="1" gap="#space_lg" vertical_align="start">
                        <panel grow="1" height="100%" gap="0">
                            <crt_bank_map title="ROML" detail="64 / 64 DATA" tone="#color_cyan" />
                        </panel>
                        <panel grow="1" height="100%" gap="0">
                            <crt_bank_map title="ROMH" detail="64 / 64 DATA" tone="#color_violet" />
                        </panel>
                    </row>

                    <row width="100%" gap="#space_md">
                        <lv_label text="STATUS" style_text_font="font_caption" style_text_color="#color_muted" />
                        <lv_label text="Scan complete. Ready to save the cartridge image."
                                  style_text_font="font_body" style_text_color="#color_ink" />
                        <box grow="1" />
                        <ui_button label="DUMP TO FILE" bg_color="#color_violet"
                                   border_color="#color_violet" text_color="#color_bg">
                            <screen_create_event screen="crt_progress" anim_type="fade_in" duration="120" />
                        </ui_button>
                    </row>
                </column>
            </crt_shell-content>
        </crt_shell>
    </view>
</screen>
