<screen>
    <view>
        <style name="style_screen" />
        <app_shell active_home="true">
            <app_shell-content>
                <column width="100%" height="100%" pad="#space_lg" gap="#space_lg">
                    <row width="100%">
                        <lv_label text="Home" style_text_font="font_title"
                                  style_text_color="#color_ink" />
                        <box grow="1" />
                        <ui_button label="OPEN LIBRARY" bg_color="#color_violet"
                                   border_color="#color_violet" text_color="#color_bg">
                            <screen_create_event screen="library" anim_type="fade_in" duration="120" />
                        </ui_button>
                    </row>

                    <row width="100%" grow="1" gap="#space_lg" vertical_align="start">
                        <panel grow="1" height="100%" gap="#space_md">
                            <row width="100%">
                                <lv_label text="CURRENT SESSION" style_text_font="font_caption"
                                          style_text_color="#color_muted" />
                                <box grow="1" />
                                <status_chip label="RUNNING" tone="#color_cyan" />
                            </row>
                            <box width="100%" grow="1" pad="#space_lg" gap="#space_sm"
                                 style_bg_color="#color_bg" style_bg_opa="100%"
                                 style_border_width="0" style_radius="#radius_sm">
                                <status_chip label="LIVE C64" tone="#color_violet" />
                                <box grow="1" />
                                <lv_label text="LAST NINJA 2" style_text_font="font_display"
                                          style_text_color="#color_ink" />
                                <lv_label text="PAL / 1.00 MHz / 50.12 Hz"
                                          style_text_font="font_caption" style_text_color="#color_muted" />
                            </box>
                            <row width="100%" gap="#space_sm">
                                <ui_button label="PAUSE" />
                                <ui_button label="MACHINE &amp; MEDIA">
                                    <screen_create_event screen="c64" anim_type="fade_in" duration="120" />
                                </ui_button>
                            </row>
                        </panel>

                        <panel width="250" height="100%" gap="0">
                            <lv_label text="STATUS" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <action_row title="Drive 8" subtitle="LN2.d64" meta="CLEAN"
                                        tone="#color_cyan">
                                <screen_create_event screen="library_actions" anim_type="fade_in" duration="120" />
                            </action_row>
                            <action_row title="Timewarp" subtitle="8.4 seconds" meta="REC"
                                        tone="#color_violet">
                                <screen_create_event screen="timewarp" anim_type="fade_in" duration="120" />
                            </action_row>
                            <action_row title="Network" subtitle="StudioNet" meta="ONLINE"
                                        tone="#color_cyan">
                                <screen_create_event screen="settings_network" anim_type="fade_in" duration="120" />
                            </action_row>
                            <box grow="1" />
                            <ui_button label="F7  QUICK ACTIONS" width="100%">
                                <screen_create_event screen="quick_actions" anim_type="fade_in" duration="120" />
                            </ui_button>
                        </panel>
                    </row>
                </column>
            </app_shell-content>
        </app_shell>
    </view>
</screen>
