<screen>
    <view>
        <style name="style_screen" />
        <crt_shell active_tab="4" state="READ ONLY" tone="#color_cyan"
                   f1="GO TO" f3="WRITE BYTE" f5="SET $01" f7="SET $DE00">
            <crt_shell-content>
                <column width="100%" height="100%" pad="#space_lg" gap="#space_md">
                    <row width="100%">
                        <column grow="1" gap="#space_xs">
                            <lv_label text="TREX CRT / INSPECT" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <lv_label text="Cart Inspector" style_text_font="font_title"
                                      style_text_color="#color_ink" />
                        </column>
                        <status_chip label="BANK 00" tone="#color_violet" />
                    </row>

                    <row width="100%" grow="1" gap="#space_lg" vertical_align="start">
                        <panel grow="1" height="100%" gap="#space_xs">
                            <row width="100%">
                                <lv_label text="ADDRESS" width="74" style_text_font="font_caption"
                                          style_text_color="#color_muted" />
                                <lv_label text="00 01 02 03 04 05 06 07 08 09 0A 0B 0C 0D 0E 0F"
                                          style_text_font="font_caption" style_text_color="#color_muted" />
                            </row>
                            <lv_label text=" $8000   43 42 4D 38 30 00 A9 37 85 01 4C 10 80 FF FF FF   CBM80..7..L....."
                                      style_text_font="font_caption" style_text_color="#color_ink" />
                            <lv_label text=" $8010   78 D8 A2 FF 9A A9 00 8D 00 DE A9 02 8D 00 DF 58   x..............X"
                                      style_text_font="font_caption" style_text_color="#color_ink" />
                            <lv_label text=" $8020   A9 0B 8D 11 D0 A9 1B 8D 16 D0 A9 00 8D 20 D0 60   ............. .`"
                                      style_text_font="font_caption" style_text_color="#color_ink" />
                            <lv_label text=" $8030   20 D2 FF A9 93 20 D2 FF A2 00 BD 00 81 F0 06 20    .... .......... "
                                      style_text_font="font_caption" style_text_color="#color_ink" />
                            <lv_label text=" $8040   D2 FF E8 D0 F5 60 54 52 45 58 20 43 52 54 00 FF   .....`TREX CRT.."
                                      style_text_font="font_caption" style_text_color="#color_ink" />
                            <lv_label text=" $8050   FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF   ................"
                                      style_text_font="font_caption" style_text_color="#color_muted" />
                            <lv_label text=" $8060   FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF   ................"
                                      style_text_font="font_caption" style_text_color="#color_muted" />
                            <lv_label text=" $8070   FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF   ................"
                                      style_text_font="font_caption" style_text_color="#color_muted" />
                            <box grow="1" />
                            <lv_label text="CURSOR UP/DOWN scrolls memory; LEFT/RIGHT changes cartridge bank"
                                      style_text_font="font_caption" style_text_color="#color_muted" />
                        </panel>

                        <panel width="260" height="100%" gap="#space_md" raised="true">
                            <lv_label text="CARTRIDGE STATE" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                            <row width="100%"><lv_label text="Type" style_text_font="font_caption" style_text_color="#color_muted" /><box grow="1" /><lv_label text="EasyFlash 3" style_text_font="font_body" style_text_color="#color_ink" /></row>
                            <row width="100%"><lv_label text="Slot" style_text_font="font_caption" style_text_color="#color_muted" /><box grow="1" /><lv_label text="2" style_text_font="font_body" style_text_color="#color_ink" /></row>
                            <row width="100%"><lv_label text="Bank" style_text_font="font_caption" style_text_color="#color_muted" /><box grow="1" /><lv_label text=" $00" style_text_font="font_body" style_text_color="#color_violet" /></row>
                            <row width="100%"><lv_label text=" $01" style_text_font="font_caption" style_text_color="#color_muted" /><box grow="1" /><lv_label text=" $37" style_text_font="font_body" style_text_color="#color_ink" /></row>
                            <row width="100%"><lv_label text=" $DE00" style_text_font="font_caption" style_text_color="#color_muted" /><box grow="1" /><lv_label text=" $02" style_text_font="font_body" style_text_color="#color_ink" /></row>
                            <row width="100%"><lv_label text="GAME / EXROM" style_text_font="font_caption" style_text_color="#color_muted" /><box grow="1" /><lv_label text="0 / 0" style_text_font="font_body" style_text_color="#color_ink" /></row>
                            <box grow="1" />
                            <lv_label text="Write Byte opens a focused address/value editor and always confirms the target."
                                      width="100%" long_mode="wrap" style_text_font="font_caption"
                                      style_text_color="#color_muted" />
                        </panel>
                    </row>
                </column>
            </crt_shell-content>
        </crt_shell>
    </view>
</screen>
