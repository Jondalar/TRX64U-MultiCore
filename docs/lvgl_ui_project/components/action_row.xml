<component>
    <api>
        <prop name="title" type="string" default="Action" />
        <prop name="subtitle" type="string" default="" />
        <prop name="meta" type="string" default="" />
        <prop name="tone" type="color" default="#color_muted" />
    </api>

    <view extends="lv_button" width="100%" height="48" flex_flow="row"
          style_flex_cross_place="center" style_pad_hor="#space_md"
          style_pad_ver="#space_sm" style_pad_column="#space_md"
          style_bg_color="#color_surface_2" style_bg_opa="0%"
          style_border_side="bottom" style_border_color="#color_line" style_border_width="1"
          style_radius="#radius_sm" style_shadow_width="0">
        <style name="style_focus" selector="focused" />
        <style name="style_focus" selector="focus_key" />
        <style name="style_pressed" selector="pressed" />
        <lv_obj width="4" height="4" style_bg_color="$tone" style_bg_opa="100%"
                style_border_width="0" style_radius="2" />
        <column grow="1" gap="#space_2xs">
            <lv_label text="$title" style_text_font="font_body" style_text_color="#color_ink" />
            <lv_label text="$subtitle" hidden="{!subtitle}"
                      style_text_font="font_caption" style_text_color="#color_muted" />
        </column>
        <lv_label text="$meta" hidden="{!meta}"
                  style_text_font="font_caption" style_text_color="$tone" />
    </view>
</component>
