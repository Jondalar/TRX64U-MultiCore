<component>
    <api>
        <prop name="number" type="string" default="1" />
        <prop name="label" type="string" default="TAB" />
        <prop name="active" type="bool" default="false" />
    </api>

    <view extends="lv_button" width="content" height="28" flex_flow="row"
          style_flex_cross_place="center" style_pad_hor="#space_sm"
          style_pad_column="#space_xs" style_radius="#radius_sm"
          style_border_width="0" style_shadow_width="0"
          style_bg_color="#color_surface_2" style_bg_opa="{active ? 255 : 0}">
        <style name="style_focus" selector="focused" />
        <style name="style_focus" selector="focus_key" />
        <style name="style_pressed" selector="pressed" />
        <keycap glyph="$number" width="22" tone="#color_violet" />
        <lv_label text="$label" style_text_font="font_caption"
                  style_text_color="{active ? color_ink : color_muted}" />
    </view>
</component>
