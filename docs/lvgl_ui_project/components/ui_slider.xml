<component>
    <api>
        <prop name="subject" type="subject" />
        <prop name="min" type="int" default="0" />
        <prop name="max" type="int" default="100" />
        <prop name="tone" type="color" default="#color_violet" />
    </api>

    <view extends="lv_slider" width="190" height="6"
          min_value="$min" max_value="$max" bind_value="$subject"
          style_bg_color="#color_line" style_bg_opa="100%" style_radius="20"
          style_bg_color-indicator="$tone" style_bg_opa-indicator="100%"
          style_radius-indicator="20" style_bg_color-knob="#color_ink"
          style_bg_opa-knob="100%" style_radius-knob="20" style_pad_all-knob="4">
        <style name="style_focus" selector="focused" />
        <style name="style_focus" selector="focus_key" />
    </view>
</component>
