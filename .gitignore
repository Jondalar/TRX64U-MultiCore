vendor/gideon/tools/checksum
vendor/gideon/tools/swap
vendor/gideon/target/**/output/
vendor/gideon/target/**/result/
out/
out-ue2/
dist/
.ci/
build_100t/
host-app/tools/hex2bin
host-app/tools/checksum
