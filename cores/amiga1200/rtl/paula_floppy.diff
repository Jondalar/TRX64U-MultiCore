> wire fd_dma_st6_wr = (fd_dma_buf_wr_state == 4'd6) && (fd_dma_buffer_trigger_wr != fd_dma_buffer_trigger_wrD);
> wire fd_dma_mw     = ce28 && !reset && (fd_dma_st2_wr || fd_dma_st6_wr);
> wire       fd_dma_mw_even = fd_dma_st2_wr ? !sdc_byte_addr[0] : fd_dma_wr_ptr[8];
> wire [7:0] fd_dma_mw_a    = fd_dma_st2_wr ? sdc_byte_addr[8:1] : fd_dma_wr_ptr[7:0];
