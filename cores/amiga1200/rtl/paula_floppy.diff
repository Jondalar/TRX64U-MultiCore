< reg [7:0]  fd_dma_buf_even[255:0];
< reg [7:0]  fd_dma_buf_odd[255:0];   
---
> // T97 5.11 (A1200 copy): the sector buffer is {even, odd} words in block RAM, one 8-bit RAM per half (no partial-word write: Vivado
> // 2024.1 tied the write enables of a 256x16 array written by byte lanes to 0, the floppy read back zeros, 5.11 finding of 2026-10-22).
> // Two copies of it, one per read register of the shared file (fd_dma_buf_out for the fifo, sdc_byte_out_data for the sd card), each
> // with its own enable and so its own hold; each RAM has exactly one write (own always block) and one read.
> (* ram_style = "block" *) reg [7:0] fd_dma_mem_fe [255:0];
> (* ram_style = "block" *) reg [7:0] fd_dma_mem_fo [255:0];
> (* ram_style = "block" *) reg [7:0] fd_dma_mem_se [255:0];
> (* ram_style = "block" *) reg [7:0] fd_dma_mem_so [255:0];
> reg fd_dma_buffer_trigger_wrD;
