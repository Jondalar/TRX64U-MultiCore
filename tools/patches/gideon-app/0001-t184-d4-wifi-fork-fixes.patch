+int wifi_reply_register(rpc_header_t *hdr)
+{
+    wifi_reply_tag_t tag;
+    ENTER_SAFE_SECTION;
+    int ok = wifi_reply_claim(replySlots, &sequence_nr, xTaskGetCurrentTaskHandle(), &tag);
+    LEAVE_SAFE_SECTION;
