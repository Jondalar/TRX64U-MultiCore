diff --git a/vendor/gideon/software/io/wifi/wifi_connection_feedback.h b/vendor/gideon/software/io/wifi/wifi_connection_feedback.h
new file mode 100644
index 000000000..f957e0a16
--- /dev/null
+++ b/vendor/gideon/software/io/wifi/wifi_connection_feedback.h
@@ -0,0 +1,72 @@
+// T184 D4: from https://github.com/omnicron-c64/ultimate-community-edition @ f7f665ab (GPL-3.0, like the rest of this tree)
+#ifndef WIFI_CONNECTION_FEEDBACK_H
+#define WIFI_CONNECTION_FEEDBACK_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+// Reason numbers follow ESP-IDF v5.3.1 esp_wifi_types_generic.h.
+static inline const char *wifi_connection_failure(unsigned reason)
+{
+    switch (reason) {
+    case 2: case 15: case 204:
+        return "WiFi handshake timed out.\nCheck password or signal.";
+    case 202: case 23:
+        return "Authentication failed.\nCheck password / AP settings.";
+    case 201:
+        return "Access point not found.\nCheck AP power and range.";
+    case 210: case 211:
+        return "No AP with matching security.\nCheck AP security settings.";
+    case 212: case 200:
+        return "WiFi signal lost or too weak.\nCheck range and signal.";
+    case 203: case 5:
+        return "Association failed.\nCheck AP settings / capacity.";
+    default:
+        return "WiFi connection failed.\nCheck AP, password and signal.";
+    }
+}
+
+// ESP-IDF esp_wifi.h request errors (ESP_ERR_WIFI_BASE = 0x3000).
+static inline const char *wifi_connection_request_failure(int error)
+{
+    switch (error) {
+    case 0x300B: return "Invalid password format.\nCheck password length / format.";
+    case 0x300A: return "Invalid access point name.\nRescan and select the AP again.";
+    case 0x102: return "Invalid connection settings.\nCheck AP name / security.";
+    case 0x101: return "WiFi module is busy.\nWait, then retry Connect.";
+    case -1: return "No valid reply from WiFi module.\nWait, then retry Connect.";
+    default: return "Connection request failed.\nCheck WiFi / network settings.";
+    }
+}
+
+static inline unsigned wifi_disconnect_reason(const void *packet, size_t size)
+{
+    // Legacy modules send only the 4-byte RPC header: reason is unavailable.
+    if (!packet || size < 6) return 0;
+    uint16_t reason;
+    memcpy(&reason, (const unsigned char *)packet + 4, sizeof(reason));
+    return reason;
+}
+
+struct WifiConnectionFeedback {
+    enum Phase { Idle, Connecting, WaitingForIP, Failed };
+    volatile Phase phase;
+    volatile unsigned reason;
+    char target[33];
+    WifiConnectionFeedback() : phase(Idle), reason(0) { target[0] = 0; }
+    void begin(const char *ssid) {
+        strncpy(target, ssid, 32); target[32] = 0;
+        reason = 0; phase = Connecting;
+    }
+    void connected(const char *ssid) {
+        if (phase == Connecting && strncmp(target, ssid, 32) == 0) phase = WaitingForIP;
+    }
+    void disconnected(unsigned code) {
+        if (phase == Idle || phase == Failed) return;
+        // Replacing an existing connection deliberately disconnects it first.
+        if (phase == Connecting && code == 8) return;
+        reason = code; phase = Failed;
+    }
+    void finish() { phase = Idle; }
+};
+#endif
diff --git a/vendor/gideon/software/io/wifi/wifi_reply.h b/vendor/gideon/software/io/wifi/wifi_reply.h
new file mode 100644
index 000000000..b52830a9b
--- /dev/null
+++ b/vendor/gideon/software/io/wifi/wifi_reply.h
@@ -0,0 +1,59 @@
+// T184 D4: from https://github.com/omnicron-c64/ultimate-community-edition @ f7f665ab (GPL-3.0, like the rest of this tree)
+#ifndef WIFI_REPLY_H_
+#define WIFI_REPLY_H_
+
+#include <stdint.h>
+#include <stddef.h>
+
+// Reply table of the WiFi command channel. The tag the module echoes in
+// hdr.thread is a slot of this table, not a TX buffer number (a TX buffer is
+// freed when it has been sent, long before the reply is there). A reply is
+// delivered only if its sequence is the one the slot was claimed with.
+// The functions are not locked: callers hold a critical section.
+
+#define WIFI_REPLY_SLOTS    12
+
+typedef struct {
+    void *task;
+    uint16_t sequence;
+} wifi_reply_slot_t;
+
+typedef struct {
+    uint8_t thread;
+    uint16_t sequence;
+} wifi_reply_tag_t;
+
+// Registers 'task' as the waiter of a free slot. Returns 0 if all are in use.
+static inline int wifi_reply_claim(wifi_reply_slot_t *slots, uint16_t *next_sequence, void *task, wifi_reply_tag_t *tag)
+{
+    for (int i = 0; i < WIFI_REPLY_SLOTS; i++) {
+        if (!slots[i].task) {
+            slots[i].task = task;
+            slots[i].sequence = (*next_sequence)++;
+            tag->thread = (uint8_t)i;
+            tag->sequence = slots[i].sequence;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+// Returns the waiter of this reply and releases its slot, or NULL if there is
+// none: the slot is free, or it belongs to another request.
+static inline void *wifi_reply_take(wifi_reply_slot_t *slots, uint8_t thread, uint16_t sequence)
+{
+    if (thread >= WIFI_REPLY_SLOTS || !slots[thread].task || slots[thread].sequence != sequence) {
+        return NULL;
+    }
+    void *task = slots[thread].task;
+    slots[thread].task = NULL;
+    return task;
+}
+
+// Gives up waiting. Returns 0 if the reply was taken in the meantime.
+static inline int wifi_reply_abandon(wifi_reply_slot_t *slots, const wifi_reply_tag_t *tag)
+{
+    return wifi_reply_take(slots, tag->thread, tag->sequence) != NULL;
+}
+
+#endif /* WIFI_REPLY_H_ */
diff --git a/vendor/gideon/software/io/wifi/wifi_scan_result.h b/vendor/gideon/software/io/wifi/wifi_scan_result.h
new file mode 100644
index 000000000..5328e1614
--- /dev/null
+++ b/vendor/gideon/software/io/wifi/wifi_scan_result.h
@@ -0,0 +1,30 @@
+// T184 D4: from https://github.com/omnicron-c64/ultimate-community-edition @ f7f665ab (GPL-3.0, like the rest of this tree)
+#ifndef WIFI_SCAN_RESULT_H
+#define WIFI_SCAN_RESULT_H
+#include <stddef.h>
+#include <string.h>
+#include "rpc_calls.h"
+
+// Decode the compact wire reply. Never interpret a failed/truncated reply as APs.
+static inline int wifi_decode_scan(const void *data, size_t size, ultimate_ap_records_t *aps)
+{
+    memset(aps, 0, sizeof(*aps));
+    const size_t prefix = offsetof(rpc_scan_resp, rec);
+    if (!data || size < prefix) return -1;
+    rpc_header_t hdr;
+    int status;
+    memcpy(&hdr, data, sizeof(hdr));
+    memcpy(&status, (const unsigned char *)data + offsetof(rpc_scan_resp, esp_err), sizeof(status));
+    if (hdr.command != CMD_WIFI_SCAN) return -1;
+    if (status) return status;
+    const size_t records = prefix + offsetof(ultimate_ap_records_t, aps);
+    if (size < records) return -1;
+    const unsigned char *bytes = (const unsigned char *)data;
+    unsigned count = bytes[prefix + offsetof(ultimate_ap_records_t, num_records)];
+    if (count > DEFAULT_SCAN_LIST_SIZE || size < records + count * sizeof(ultimate_ap_record_t)) return -1;
+    memcpy(aps->aps, bytes + records, count * sizeof(ultimate_ap_record_t));
+    for (unsigned i = 0; i < count; ++i) aps->aps[i].ssid[32] = 0;
+    aps->num_records = count;
+    return 0;
+}
+#endif
