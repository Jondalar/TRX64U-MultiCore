# The two generic packages of the Gitea registry (T171). Plain shell assignments, read by ci/lib.sh and tools/*.sh.
# MC_PKG: ours - everything this repository's CI publishes and everything read back of it.
# FW_PKG: TRX64-Ultimate's - read only, and only for the files imported through release/imports/*.pin (tools/pack_import_cor.sh).
MC_PKG=trx64u-multicore
FW_PKG=trx64-ultimate
