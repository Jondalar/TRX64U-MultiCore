# Plain shell assignments, read by ci/lib.sh and tools/*.sh.
# MC_BUILDS_REPO: the public repository of the builds (T239.1 D1, D19): the pre-releases <branch>-<sha8> of the CI packages and the immutable releases bit-<cache entry>
# of the bitstreams. The pipeline writes only its pre-release (ci/publish_release.py, job prerelease); the builder's pull pipeline writes the bit-* releases.
# MC_SRC_REPO: the repository whose pushes may publish there; ci/publish_release.py refuses any other (a fork's run has another GITHUB_REPOSITORY).
# FW_PKG: TRX64-Ultimate's generic package of the Gitea registry - read only, and only for the files imported through release/imports/*.pin (tools/pack_import_cor.sh, D22).
MC_BUILDS_REPO=Jondalar/trx64mc-builds
MC_SRC_REPO=Jondalar/TRX64U-MultiCore
FW_PKG=trx64-ultimate
