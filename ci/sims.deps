# What each bench of ci/sims.txt reads (T31 §Per-bench cache, ci/sims.sh).
#
#   @name = spec ...      a macro, replaced wherever @name appears further down
#   bench: spec ...       the inputs of bench <bench>; an indented line goes on
#
# A spec is a git pathspec from the repository root: a file, a directory (every
# tracked file below it), a :(glob) or an :(exclude). Only tracked files count, so
# build/ directories and generated files never do. ci/sims.sh adds the bench's line of
# ci/sims.txt, the versions of iverilog/ghdl/verilator and its own `driver=<n>` to the key -
# not the content of ci/sims.sh, which would make every edit of the driver cost all 46 benches
# (T100 D5).
#
# A bench without a line here keeps the key of the whole tree (designs cores tools
# roms ci): any change in those reruns it, nothing is ever skipped wrongly.
# A spec that matches no tracked file makes the bench fall back the same way.
#
# Keep a line COMPLETE: what a bench reads and this list lacks is a change that does
# not rerun it. ci/sims.sh --check-deps NAME runs the bench in a copy that holds only
# these files, so a missing input fails there; the iverilog benches are also checked
# on every run (the compiler's own list of files it read, ci/sim_iv.sh).

# Gideon's VHDL: vendor/gideon is our own copy, in git (tools/gideon_sources.sh renews it); the benches read the VHDL and the files beside it,
# not the software of the two applications that lives in the same tree
@gideon = vendor/gideon/fpga vendor/gideon/target/simulation vendor/gideon/LICENSE.txt vendor/gideon/software/io/usb/nano_minimal.nan vendor/gideon/software/portable/riscv/bootloader_u64ii.c vendor/gideon/tools/parse_nano.py tools/gideon_sources.sh tools/vendor_gideon.sh tools/patches/gideon
# build.tcl's VHDL list is what eth and input compile besides Gideon's files
@bt_vhdl = host/gideon_vhdl.tcl cores/common/drive_l2.vhd host/bootrom_pkg.vhd host/usb_dpram.vhd host/pseudo_dpram_8x32_x7.vhd cores/common/drive_mem.vhd cores/common/drive_unit.vhd host/uci_unit.vhd host/flash_gate.vhd host/ultimate_sys.vhd host/sim/usb/unisim_sim.vhd host/sim/usb/tl_string_util_pkg.vhd
# the shared MIG UI model and DDR2 port
@mig = host/ddr2_port.v host/sim/mig_ui_model.v
# ddr2_lean, its calibration sequencer, the DDR2 and Xilinx primitive models, the run script (OPT-ddr2)
@ddr2 = host/ddr2_lean.v host/cal_seq.v designs/ddr2_test/sim/xilinx_models.v designs/ddr2_test/sim/ddr2_model.v designs/ddr2_test/sim/run.sh

trx_io: host/sim/trx_io cores/common/trx_io.v cores/common/trx_sys.v
cart_unit: host/sim/cart_unit cores/c64ref/cart_slot_c64ref.v host/cart_fill.v cores/common/trx_io.v
host_hdmi_timing: host/sim/hdmi_timing host/hdmi_timing.v host/hdmi_modes.vh
host_modepath: host/sim/modepath host/mode_req.v host/cdce_mode.v host/hdmi_timing.v host/hdmi_modes.vh
  tools/gen_cart_descriptors.py tools/cart_descriptors
  vendor/icepi/c64_cartridge.v vendor/icepi/c64_flash_amd.v vendor/icepi/c64_eeprom_93c86.v vendor/icepi/c64_action_replay
ring_f4: host/sim/ring/run_f4.sh host/sim/ring/tb_eng_f4.v cores/common/trx_engine.v

# rvlite multiply (opt-rvmul): Gideon's rvlite as vendored and patched, run under GHDL against gen.py's model
rvmul: host/sim/rvmul host/sim/usb/tl_string_util_pkg.vhd @gideon

# rvlite trap/mret under interrupts with wait states (T97 5.13): the vendored core with a monitor spliced in
rvtrap: host/sim/rvtrap host/sim/usb/tl_string_util_pkg.vhd host/bootrom_pkg.vhd @gideon

# T133 host data cache: the cache alone against a bus model (dcache), and the core with the cache under interrupts (rvtrap_dc)
rvtrap_dc: host/sim/rvtrap host/sim/usb/tl_string_util_pkg.vhd host/bootrom_pkg.vhd host/cache_cfg_pkg.vhd host/rv_dcache.vhd host/rv_icache.vhd host/rvlite_wrapper_dc.vhd @gideon
dcache: host/sim/dcache host/rv_dcache.vhd @gideon

