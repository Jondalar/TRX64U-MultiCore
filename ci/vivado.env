# The build options of the gateware lanes, one KEY=VALUE per line, no quotes, no comment after a value. The one place that has them:
# ci/keys.sh reads them for the cache keys, ci/pack_one.sh and the builder's build job export them before Vivado. Part and Vivado version are
# not here (the part is the c64u branch of ci/bitstream.sh, the version is in the key text of ci/lib.sh).
# Flat builds of the large cores get no options (ci/bitstream_mono.sh): their variant is the core's mono_env.
# TRX_SID: two-SID reDIP instead of reSID8
TRX_SID=redip2
# TRX_FEATURES: JTAG debug on, UDP streams and the rest off
TRX_FEATURES=jtag
# T79_GREYBOX: also write the grey-box partial (swap core -> empty -> core); not part of a key
T79_GREYBOX=1
# T79_FLOOR: compact core region instead of the L
T79_FLOOR=B
# TRX_CORE: also build the VC-20, Amiga and C264 modules and their partial bitstreams; not part of a layered key
TRX_CORE=vc20,amiga,c264
