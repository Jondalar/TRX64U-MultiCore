    { "cd32keys.toml",
        "# Amiga CD32 pad in port 2, one button at a time: which port pin or comparator bit each button moves, with the pot lines left free\n"
        "# (DIS = 1, as stick2). A CD32 pad that is not switched into its shift mode (pin 5 high) acts as a joystick: then only the directions,\n"
        "# red (pin 6) and blue (pin 9) can move anything, and the other buttons show nothing. The samples in the result show which bit moved.\n"
        "kind = \"test\"\n"
        "\n"
        "[test]\n"
        "name = \"CD32 pad buttons one by one, port 2\"\n"
        "id = \"cd32keys\"\n"
        "version = 1\n"
        "needs = [\"CD32 pad\"]\n"
        "\n"
        "[[prompt]]\n"
        "id = \"idle\"\n"
        "text = \"Plug the CD32 pad into port 2 and touch nothing. Then press RETURN.\"\n"
        "timeout_s = 120\n"
        "\n"
        "[[prompt]]\n"
        "id = \"red\"\n"
        "text = \"Let go of everything. HOLD the RED button only and keep holding it, also while you press RETURN.\"\n"
        "timeout_s = 300\n"
        "\n"
        "[[prompt]]\n"
        "id = \"blue\"\n"
        "text = \"Let go of everything. HOLD the BLUE button only and keep holding it, also while you press RETURN.\"\n"
