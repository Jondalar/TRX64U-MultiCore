# trx64g.cor (T104.2 Q5): the same monolith bitstream with Gideon's Ultimate application, both taken from the TRX64-Ultimate CI package
# trx64-ultimate/<PKG_VERSION> (read only). APP_FILE is the .app (12-byte record header + image); the packer strips it and refuses a file whose
# SHA-256 is not APP_SHA256.
ID=trx64g
NAME="TRX64 Ultimate (Gideon app)"
VERSION=d94aa68e
# T253 D3: main-d94aa68e is the TRX64-Ultimate release 0.3.1, the patch release with the I2C fix (c392beed: the P7 scan on the 1.8 V bus only); Gitea prerelease trx64-main-d94aa68e, its manifest carries "version": "0.3.1"
SEMVER=0.3.1
PKG_VERSION=main-d94aa68e
BIT_FILE=c64_basic.bit
BIT_SHA256=c950aa551912decac2c684f95f68fea7b5723584463fefcf756fd315f53884ae
APP_FILE=ultimate.app
APP_SHA256=32b177616b8512a8159b7c712baa8d860f8d70f4e4022bc8dad197524bb46f52
ICON=tools/core_logos/trx64/icon.rgb565
