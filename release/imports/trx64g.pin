# trx64g.cor (T104.2 Q5): the same monolith bitstream with Gideon's Ultimate application, both taken from the TRX64-Ultimate CI package
# trx64-ultimate/<PKG_VERSION> (read only). APP_FILE is the .app (12-byte record header + image); the packer strips it and refuses a file whose
# SHA-256 is not APP_SHA256.
ID=trx64g
NAME="TRX64 Ultimate (Gideon app)"
VERSION=8f1dc184
# T230 P-1: main-8f1dc184 is the TRX64-Ultimate release 0.3.0 (Gitea prerelease trx64-main-8f1dc184, APPL_VERSION_NUMBER of its app)
SEMVER=0.3.0
PKG_VERSION=main-8f1dc184
BIT_FILE=c64_basic.bit
BIT_SHA256=1180391a81a4cf6ff73d68b648031a960f346b26ca31ab936bfa540201014f45
APP_FILE=ultimate.app
APP_SHA256=b25ff5353c9597e8865ff6c31d254d81e5e6b1a1f3f202dbaa6b451c00cec4fc
ICON=tools/core_logos/trx64/icon.rgb565
