# trx64u.cor: the large TRX64 .cor that runs OUR generic core application (T104.2): the monolith bitstream of TREX/TRX64-Ultimate (read only, never built
# here) plus coreapp.bin of stage trxapps, packed by tools/pack_import_cor.sh in ci/package.sh. A new bitstream = a new pin, reviewed.
# Shell variables; the bitstream is a file of the TRX64-Ultimate CI generic package trx64-ultimate/<PKG_VERSION>.
ID=trx64u
NAME="TRX64U"
VERSION=d94aa68e
# T253 D3: main-d94aa68e is the TRX64-Ultimate release 0.3.1, the patch release with the I2C fix (c392beed: the P7 scan on the 1.8 V bus only); Gitea prerelease trx64-main-d94aa68e, its manifest carries "version": "0.3.1"
SEMVER=0.3.1
PKG_VERSION=main-d94aa68e
BIT_FILE=c64_basic.bit
BIT_SHA256=c950aa551912decac2c684f95f68fea7b5723584463fefcf756fd315f53884ae
ICON=tools/core_logos/trx64/icon.rgb565
DESC=coreapp/cores/trx64u/menu.toml
OPS=tests/coreapp/golden/ops_trx64u.txt
# T228 R21 item 7: record 8 of the .cor, the files the application installs into the core folder (the SID player's C64 programs, release/imports/trx64u_files/README)
FILES=release/imports/trx64u_files
# T228: deactivated on 2026-11-17 (Alex, "only deactivate! do not delete .. first we fix the UI, then we build the core again", translated) by a
# line that set PIPELINE to false (ci/package.sh packed nothing then); the line is gone since 2026-11-18: T228 is merged, trx64u ships in 0.2.0.
# T239.3 D15: the heap of this core (T228 R25: 0x950000, the OWN_HEAP of ci/trxapps.sh), written into the heap word of the application by the packer
HEAP=0x950000
