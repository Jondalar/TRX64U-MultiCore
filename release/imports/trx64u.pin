# trx64u.cor: the large TRX64 .cor that runs OUR generic core application (T104.2): the monolith bitstream of TREX/TRX64-Ultimate (read only, never built
# here) plus coreapp.bin of stage trxapps, packed by tools/pack_import_cor.sh in ci/package.sh. A new bitstream = a new pin, reviewed.
# Shell variables; the bitstream is a file of the TRX64-Ultimate CI generic package trx64-ultimate/<PKG_VERSION>.
ID=trx64u
NAME="TRX64U"
VERSION=31e69921
# T230 S1: main-31e69921 is the TRX64-Ultimate release 0.3.0 (Gitea prerelease trx64-main-31e69921, release run 2323; its manifest carries "version": "0.3.0")
SEMVER=0.3.0
PKG_VERSION=main-31e69921
BIT_FILE=c64_basic.bit
BIT_SHA256=149b4dfb3cba0948949d9cf83420b0113cd65d3a8ecf9e4c644a89b50b368733
ICON=tools/core_logos/trx64/icon.rgb565
DESC=coreapp/cores/trx64u/menu.toml
OPS=tests/coreapp/golden/ops_trx64u.txt
# T228 (Alex 2026-11-17, "only deactivate! do not delete .. first we fix the UI, then we build the core again", translated): out of the
# release and not packed by ci/package.sh while PIPELINE=false; PIPELINE=true (or the line removed) brings trx64u back.
PIPELINE=false
